<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="address" inherit_id="website_sale.address">
        <xpath expr="//div[@id='div_name']" position="replace">
            <div id="div_name" class="col-lg-12 mb-2">
                <input
                    id="o_name"
                    type="hidden"
                    name="name"
                    t-att-value="partner_sudo.name"
                    class="form-control"
                />
            </div>
            <div id="div_firstname" class="col-lg-6 mb-2">
                <label class="col-form-label" for="o_firstname">Firstname</label>
                <input
                    id="o_firstname"
                    type="text"
                    name="firstname"
                    t-att-value="partner_sudo.firstname"
                    class="form-control"
                />
            </div>
            <div id="div_lastname" class="col-lg-6 mb-2">
                <label class="col-form-label" for="o_lastname">Lastname</label>
                <input
                    id="o_lastname"
                    type="text"
                    name="lastname"
                    t-att-value="partner_sudo.lastname"
                    class="form-control"
                />
            </div>
        </xpath>
    </template>
</odoo>
