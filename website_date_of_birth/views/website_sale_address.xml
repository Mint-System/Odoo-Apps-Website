<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="address_form"
        inherit_id="website_sale.address"
        name="Show Date of Birth"
        priority="99"
    >
        <xpath expr="//form/div[1]/div[2]" position="after">
            <div id="div_date_of_birth" class="col-lg-12 mb-2">
                <label
                    class="col-form-label"
                    for="o_date_of_birth"
                >Date of birth</label>
                <input
                    id="o_date_of_birth"
                    type="date"
                    name="date_of_birth"
                    t-att-value="partner_sudo.date_of_birth"
                    class="form-control"
                />
            </div>
        </xpath>

        <xpath expr="//input[@name='required_fields']" position="replace">
            <input
                type="hidden"
                name="required_fields"
                t-att-value="'phone,name,date_of_birth'"
            />
        </xpath>
    </template>
</odoo>
