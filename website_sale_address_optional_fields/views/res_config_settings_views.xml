<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.address_optional_fields</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_shop_checkout" position="inside">
                <setting id="address_optional_fields_setting" string="Optional Address Fields" help="Fields that are not required in the shop address form.">
                    <field name="address_optional_field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
