<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hide_products_until_pricelist"
          inherit_id="website_sale.products"
          priority="1000">

        <xpath expr="//div[contains(@class,'o_wsale_products_grid_table_wrapper')]"
           position="attributes">
            <attribute name="t-attf-class">
                #{'d-none' if website.pricelist_id.is_dummy else ''}
            </attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' products_pager ')]"
           position="attributes">
            <attribute name="t-attf-class">
                #{'d-none' if website.pricelist_id.is_dummy else ''}
            </attribute>
        </xpath>
     
        <xpath expr="//div[contains(@class,'products_header')]"
           position="before">
            <t t-if="website.pricelist_id.is_dummy">
                <div class="oe_structure alert alert-warning w-100 mb-3" id="website_product_global_text">
                   Wählen Sie unten als Erstes die für Sie zutreffende Preisliste aus.
                </div>
            </t>
        </xpath>
    </template>

    <template id="hide_dummy_pricelist_option"
        inherit_id="website_sale.pricelist_list"
        priority="50">
        <xpath expr="//t[@t-foreach='website_sale_pricelists']"
           position="replace">
            <t t-foreach="website_sale_pricelists.filtered(lambda p: not p.is_dummy)"
               t-as="pl">
                <a role="menuitem"
                   t-att-href="'/shop/change_pricelist/%s' % pl.id"
                   class="dropdown-item">
                    <span class="switcher_pricelist small"
                          t-att-data-pl_id="pl.id"
                          t-esc="pl.name"/>
                </a>
            </t>
        </xpath>

        <xpath expr="//a[contains(@t-attf-class,'dropdown-toggle')]/t"
           position="replace">
            <t t-if="pricelist and pricelist.is_dummy">
                Bitte wählen Sie ein Preismodell.
            </t>
            <t t-else="">
                <t t-esc="pricelist.name"/>
            </t>

        </xpath>
    
    </template>

    <template id="hide_dummy_pricelist_offcanvas"
          inherit_id="website_sale.o_wsale_offcanvas"
          priority="1300">

        <xpath expr="//a[@t-foreach='website_sale_pricelists']"
               position="replace">

            <a t-foreach="website_sale_pricelists.filtered(lambda p: not p.is_dummy)"
               t-as="pl"
               role="menuitem"
               rel="noindex,nofollow"
               t-att-href="'/shop/change_pricelist/%s' % pl.id"
               class="list-group-item border-0 ps-0 pb-0">

                <div class="form-check d-inline-block">
                    <input type="radio"
                           t-attf-onclick="location.href='/shop/change_pricelist/#{pl.id}';"
                           class="form-check-input o_not_editable"
                           name="wsale_pricelist_radios_offcanvas"
                           t-att-checked="curr_pl == pl"/>
                    <label class="form-check-label fw-normal"
                           t-out="pl.name"/>
                </div>

            </a>

        </xpath>
        
       
    </template>


</odoo>
