<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="hide_products_until_pricelist"
        inherit_id="website_sale.products"
        priority="1000"
    >
        <xpath
            expr="//div[contains(@class,'o_wsale_products_grid_table_wrapper')]"
            position="attributes"
        >
            <attribute name="t-attf-class">
                #{'d-none' if website.pricelist_id.is_dummy else ''}
            </attribute>
        </xpath>
        <xpath
            expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' products_pager ')]"
            position="attributes"
        >
            <attribute name="t-attf-class">
                #{'d-none' if website.pricelist_id.is_dummy else ''}
            </attribute>
        </xpath>

        <xpath expr="//div[contains(@class,'products_header')]" position="before">
            <t t-if="website.pricelist_id.is_dummy">
                <div
                    class="oe_structure alert alert-warning w-100 mb-3"
                    id="website_product_global_text"
                >
                   Wählen Sie unten als Erstes die für Sie zutreffende Patentart aus.
                </div>
            </t>
        </xpath>
    </template>

