<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="products" inherit_id="website_sale.products">
        <xpath expr="//t[@t-call='website_sale.pricelist_list']/t[@t-set='_classes']" position="attributes">
             <attribute name="t-valuef">d-none d-lg-none</attribute>
        </xpath>

        <xpath expr="//section[@id='o_wsale_products_grid']" position="before">
            <t t-call="website_sale_permit_extra_info.pricelist_checkboxes"/>
        </xpath>
    </template>

    <template id="product" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_detail_main']" position="before">
            <t t-call="website_sale_permit_extra_info.pricelist_checkboxes"/>
        </xpath>
    </template>


    <template id="pricelist_list" inherit_id="website_sale.pricelist_list">
        <xpath expr="//div[contains(@t-attf-class, 'o_pricelist_dropdown')]" position="attributes">
            <attribute name="t-attf-class">o_pricelist_dropdown dropdown d-lg-none #{_classes if hasPricelistDropdown else 'd-none'}</attribute>
        </xpath>
    </template>

    <template id="pricelist_checkboxes" name="Pricelist Checkbox List">
        <t name="Pricelists Checkboxes" t-name="pricelist_checkboxes">
            <t t-set="website_sale_pricelists" t-value="website.get_pricelist_available(show_visible=True)" />
            <t t-set="hasPricelistCheckbox" t-value="website_sale_pricelists and len(website_sale_pricelists) > 1"/>
            <t t-set="pricelist" t-value="website.pricelist_id"/>
            <div t-attf-class="container mt-4 d-none d-lg-block #{'d-none' if not hasPricelistCheckbox else ''}">

                <t t-if="len(website_sale_pricelists) == 1">
                    <t
                        t-set="auto_selected_pricelist"
                        t-value="filtered_pricelists[0]"
                    />
                    <t t-if="auto_selected_pricelist.id != pricelist.id">
                        <!-- Auto-select the only pricelist by redirecting -->
                        <script>
                            window.location.href = '/shop/change_pricelist/<t
                            t-esc="auto_selected_pricelist.id"
                        />';
                        </script>
                    </t>
                </t>

                <t t-if="len(website_sale_pricelists) > 1">
                    <div
                        class="mb-2 fw-semibold oe_structure"
                        id="website_checkboxes_intro_text"
                    >
                            Bitte wählen Sie das zutreffende Patent aus:
                    </div>

                    <t t-foreach="website_sale_pricelists" t-as="pl">
                        <div class="form-check">
                            <input
                                type="radio"
                                name="pricelist"
                                class="form-check-input"
                                t-att-id="'pl_%s' % pl.id"
                                t-att-checked="pl.id == pricelist.id"
                                t-att-onchange="'window.location.href=\'/shop/change_pricelist/%s\'' % pl.id"
                            />
                            <label class="form-check-label" t-att-for="'pl_%s' % pl.id">
                                <t t-esc="pl.name" />
                            </label>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

</odoo>



