<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="product_quantity"
        inherit_id="website_sale.product_quantity"
        priority="1000"
    >
        <xpath expr="//a[hasclass('js_add_cart_json')][1]" position="attributes">
            <attribute name="t-attf-id">minus_btn_{{ product.id }}</attribute>
        </xpath>
        <xpath expr="//a[hasclass('js_add_cart_json')][2]" position="attributes">
            <attribute name="t-attf-id">plus_btn_{{ product.id }}</attribute>
        </xpath>
        <xpath expr="//input[@name='add_qty']" position="attributes">
            <attribute name="t-attf-id">qty_input_{{ product.id }}</attribute>
        </xpath>

        <xpath expr="//input[@name='add_qty']" position="replace">
            <t t-set="display_qty" t-value="1" />
            <t t-if="product.is_sale_own_min_qty_set">
                <t t-set="min_qty" t-value="product.sale_min_qty or 1" />
                <t
                    t-set="display_qty"
                    t-value="int(min_qty) if float(min_qty).is_integer() else min_qty"
                />
            </t>
            <input
                type="text"
                class="form-control quantity text-center"
                t-att-data-min-qty="min_qty"
                name="add_qty"
                t-att-value="display_qty"
                t-att-data-product-id="product.id"
            />
        </xpath>
    </template>
</odoo>
